<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ESPWebBridge.ViewModels"
        xmlns:views="using:ESPWebBridge.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        d:DataContext="{x:Static vm:DesignData.Main}"
        x:Class="ESPWebBridge.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ESPWebBridge">

    <TabControl >
        <TabItem Header="Services">
            <views:ServicesView DataContext="{Binding ServicesModel}" />
        </TabItem>
        <TabItem Header="Web Preview">
            T.B.D.
        </TabItem>
    </TabControl>

</Window>
