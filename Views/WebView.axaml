<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ESPWebBridge.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        d:DataContext="{x:Static vm:DesignData.WebView}"
        x:Class="ESPWebBridge.Views.WebView"
        x:DataType="vm:WebViewModel">
    <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, *"
          Margin="10"
          RowSpacing="10" ColumnSpacing="10">
        <TextBox x:Name="AddressBox"
                 Text="{Binding Address}"
                 KeyDown="AddressBox_KeyDown"
                 Grid.Row="0" Grid.Column="1"
                 FontSize="10" />
        <Border BorderBrush="#AC2B2B2B" BorderThickness="2"
                Grid.Row="1" Grid.ColumnSpan="4">
            <NativeWebView x:Name="Browser"
                Source="{Binding WebPrewiewUri}"/>
        </Border>
    </Grid>

</UserControl>
