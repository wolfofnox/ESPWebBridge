<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ESPWebBridge.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:options="using:ESPWebBridge.Services.Options"
        xmlns:controls="using:ESPWebBridge.Controls"
        d:DataContext="{x:Static vm:DesignData.Services}"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ESPWebBridge.Views.ServicesView"
        x:DataType="vm:ServicesViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type options:TextOption}">
            <TextBox Text="{Binding Value, Mode=TwoWay}"
                     PlaceholderText="{Binding Label}"
                     ToolTip.Tip="{Binding Label}"
                     TextWrapping="NoWrap"
                     MinWidth="0" MaxWidth="300" Height="22" MinHeight="22"
                     Margin="3,0" Padding="5,1" FontSize="11"
                     VerticalContentAlignment="Center" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type options:ToggleOption}">
            <CheckBox IsChecked="{Binding Value, Mode=TwoWay}"
                      ToolTip.Tip="{Binding Label}"
                      Width="20" Height="20"
                      VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type options:NumberOption}">
            <TextBox Text="{Binding Value, Mode=TwoWay}"
                     PlaceholderText="{Binding Label}"
                     ToolTip.Tip="{Binding Label}"
                     TextWrapping="NoWrap"
                     MinWidth="0" MaxWidth="128" Height="22" MinHeight="22"
                     Padding="5,1" FontSize="11"
                     VerticalContentAlignment="Center" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type options:ComboBoxOption}">
            <ComboBox ItemsSource="{Binding Choices}"
                      SelectedIndex="{Binding SelectionIndex, Mode=TwoWay}"
                      ToolTip.Tip="{Binding Label}"
                      MinWidth="0" MaxWidth="150" Height="22" MinHeight="22"
                      Padding="5,1" FontSize="11"
                      VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type options:ButtonOption}">
            <Button MinWidth="40" Height="30" Margin="3" FontSize="12"
                    TextBlock.TextAlignment="Center"
                    Content="{Binding Label}"
                    Command="{Binding ClickCommand}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type options:OptionGroup}">
            <Border BorderBrush="#41000000" BorderThickness="1" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="7" VerticalAlignment="Center"
                            FontSize="13" Text="{Binding Label}" />
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ShrinkToFitPanel Spacing="5"></controls:ShrinkToFitPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>
    <ItemsControl ItemsSource="{Binding Services}"
                VerticalAlignment="Center"
                Margin="3"
                MaxWidth="600">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="#34808080"
                        BorderThickness="2" BorderBrush="#60808080"
                        Margin="4" CornerRadius="12">
                        <Grid VerticalAlignment="Center"
                              ColumnDefinitions="Auto,1*,Auto,Auto, Auto"
                              RowDefinitions="Auto, Auto, Auto">
                            <TextBlock Grid.Column="0"
                                       Margin="7" VerticalAlignment="Center"
                                       FontSize="13" Text="{Binding Name}" />
                            <ItemsControl Grid.Column="1" VerticalAlignment="Center"
                                          ItemsSource="{Binding QuickOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ShrinkToFitPanel Spacing="5" Margin="7, 3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Grid.Column="2"
                                    Width="58" Height="30" Margin="3" FontSize="12"
                                    TextBlock.TextAlignment="Center"
                                    Content="{Binding ButtonText}"
                                    Command="{Binding ToggleCommand}" />
                            <Border Grid.Column="3"
                                    CornerRadius="8" Width="16" Height="16"
                                    Margin="7, 7, 7, 7" VerticalAlignment="Center"
                                    Background="{Binding StatusBrush}" />
                            <Button Grid.Column="4"
                                    Width="24" Height="24" MinWidth="0" MinHeight="0"
                                    Padding="0" Margin="4, 4, 8, 4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    FontSize="23" FontWeight="SemiBold"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    ToolTip.Tip="Show other options"
                                    Command="{Binding ToggleOtherOptionsCommand}">
                                <Image Source="{Binding OtherOptionsChevron}" />
                            </Button>
                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="5"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding OtherOptions}"
                                IsVisible="{Binding ShowOtherOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="5" Margin="7, 3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Grid.Row="2" Grid.ColumnSpan="5"
                                    IsVisible="{Binding HasError}"
                                    Background="#40FF0000"
                                    CornerRadius="6"
                                    Margin="7,0,7,7"
                                    Padding="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="X"
                                            MinHeight="0" Height="20"
                                            Width="20"
                                            Padding="1"
                                            TextBlock.TextAlignment="Center"
                                            FontSize="12"
                                            Command="{Binding DismissErrorCommand}"/>
                                </Grid>
                            </Border>
                        </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
